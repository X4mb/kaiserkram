<section class="trader-body">
  <header class="trader-header">
    <img class="trader-portrait" src="{{trader.img}}" alt="{{trader.name}}" />
    <div class="trader-title">
      <h1>{{trader.name}}</h1>
      <div class="trader-status {{#if config.open}}is-open{{else}}is-closed{{/if}}">
        {{#if config.open}}
          <i class="fa-solid fa-door-open"></i> {{localize "kaiserkram.trader.sheet.open"}}
        {{else}}
          <i class="fa-solid fa-door-closed"></i> {{localize "kaiserkram.trader.sheet.closed"}}
        {{/if}}
      </div>
    </div>
    <div class="trader-customer">
      {{#if customers.length}}
        <label>
          {{localize "kaiserkram.trader.sheet.tradingAs"}}
          <select data-customer-select>
            {{#each customers}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>
        {{#if customer}}
          <div class="trader-purse" data-tooltip="{{localize "kaiserkram.trader.sheet.yourPurse"}}">
            <i class="fa-solid fa-coins"></i> {{customer.purse}}
          </div>
          {{#if customer.penalty}}
            <div class="trader-grudge" data-tooltip="{{localize "kaiserkram.trader.sheet.grudgeHint"}}">
              <i class="fa-solid fa-face-angry"></i> +{{customer.penalty}}%
            </div>
          {{/if}}
        {{/if}}
      {{else}}
        <p class="hint">{{localize "kaiserkram.trader.sheet.noCharacter"}}</p>
      {{/if}}
    </div>
  </header>

  {{#if isGM}}
    <nav class="trader-toolbar">
      <button type="button" data-action="toggleOpen">
        {{#if config.open}}
          <i class="fa-solid fa-door-closed"></i> {{localize "kaiserkram.trader.gm.close"}}
        {{else}}
          <i class="fa-solid fa-door-open"></i> {{localize "kaiserkram.trader.gm.open"}}
        {{/if}}
      </button>
      <button type="button" data-action="showPlayers" data-tooltip="{{localize "kaiserkram.trader.gm.showPlayersHint"}}"><i class="fa-solid fa-bullhorn"></i> {{localize "kaiserkram.trader.gm.showPlayers"}}</button>
      <button type="button" data-action="restock"><i class="fa-solid fa-boxes-stacked"></i> {{localize "kaiserkram.trader.gm.restock"}}</button>
      <button type="button" data-action="openActorSheet"><i class="fa-solid fa-user"></i> {{localize "kaiserkram.trader.gm.npcSheet"}}</button>
    </nav>
  {{/if}}

  <div class="trader-scroll">
    {{#if isGM}}
      <details class="trader-help" {{#unless hasStock}}open{{/unless}}>
        <summary><i class="fa-solid fa-circle-question"></i> {{localize "kaiserkram.trader.help.title"}}</summary>
        <ol>
          <li>{{localize "kaiserkram.trader.help.stock"}}</li>
          <li>{{localize "kaiserkram.trader.help.prices"}}</li>
          <li>{{localize "kaiserkram.trader.help.open"}}</li>
          <li>{{localize "kaiserkram.trader.help.players"}}</li>
          <li>{{localize "kaiserkram.trader.help.trade"}}</li>
        </ol>
      </details>
    {{/if}}
    <h2><i class="fa-solid fa-store"></i> {{localize "kaiserkram.trader.sheet.forSale"}}</h2>
    {{#if hasStock}}
      <table class="trader-table trader-stock">
        <thead>
          <tr>
            <th class="col-name">{{localize "kaiserkram.trader.sheet.item"}}</th>
            <th class="col-qty">{{localize "kaiserkram.trader.sheet.qty"}}</th>
            {{#if isGM}}
              <th class="col-price">{{localize "kaiserkram.trader.sheet.book"}}</th>
              <th class="col-price">{{localize "kaiserkram.trader.sheet.override"}}</th>
            {{/if}}
            <th class="col-price">{{localize "kaiserkram.trader.sheet.price"}}</th>
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody>
          {{#each stock}}
            <tr class="stock-row {{#if soldOut}}sold-out{{/if}} {{#unless forSale}}not-for-sale{{/unless}}" data-item-id="{{id}}">
              <td class="col-name">
                <details>
                  <summary>
                    <img src="{{img}}" alt="" />
                    <span class="item-name">{{name}}</span>
                    {{#if ../isGM}}
                      {{#unless forSale}}<span class="tag">{{localize "kaiserkram.trader.sheet.notForSale"}}</span>{{/unless}}
                    {{/if}}
                  </summary>
                  <div class="item-description">{{{description}}}</div>
                </details>
              </td>
              <td class="col-qty">
                {{#if ../isGM}}
                  <input type="number" min="0" step="1" value="{{qty}}" data-item-field="qty" {{#if infinite}}disabled{{/if}} />
                  <label class="inline" data-tooltip="{{localize "kaiserkram.trader.sheet.infiniteHint"}}">
                    <input type="checkbox" data-item-field="infinite" {{#if infinite}}checked{{/if}} /> ∞
                  </label>
                {{else}}
                  {{qtyLabel}}
                {{/if}}
              </td>
              {{#if ../isGM}}
                <td class="col-price">
                  <input type="text" value="{{book}}" data-item-field="book" />
                </td>
                <td class="col-price">
                  <input type="text" value="{{override}}" placeholder="{{list}}" data-item-field="override"
                    data-tooltip="{{localize "kaiserkram.trader.sheet.overrideHint"}}" />
                </td>
              {{/if}}
              <td class="col-price">
                <span class="price {{#if adjusted}}{{#if cheaper}}is-cheaper{{else}}is-dearer{{/if}}{{/if}}">{{price}}</span>
                {{#if adjusted}}<s class="list-price">{{list}}</s>{{/if}}
                {{#if deal}}<span class="tag deal">−{{deal}}%</span>{{/if}}
              </td>
              <td class="col-actions">
                {{#if ../customer}}
                  {{#unless soldOut}}
                    <button type="button" data-action="buy" data-tooltip="{{localize "kaiserkram.trader.sheet.buy"}}">
                      <i class="fa-solid fa-cart-shopping"></i>
                    </button>
                    {{#if canHaggle}}
                      <button type="button" data-action="haggle" data-tooltip="{{localize "kaiserkram.trader.sheet.haggle"}}">
                        <i class="fa-solid fa-scale-balanced"></i>
                      </button>
                    {{/if}}
                  {{/unless}}
                {{/if}}
                {{#if ../isGM}}
                  <label class="inline" data-tooltip="{{localize "kaiserkram.trader.sheet.forSaleHint"}}">
                    <input type="checkbox" data-item-field="forSale" {{#if forSale}}checked{{/if}} />
                  </label>
                  <button type="button" data-action="openItem" data-tooltip="{{localize "kaiserkram.trader.sheet.edit"}}">
                    <i class="fa-solid fa-pen"></i>
                  </button>
                  <button type="button" data-action="removeItem" data-tooltip="{{localize "kaiserkram.trader.gm.removeItem"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p class="hint">{{localize "kaiserkram.trader.sheet.empty"}}</p>
    {{/if}}
    {{#if isGM}}
      <p class="hint">{{localize "kaiserkram.trader.sheet.dropHintGM"}}</p>
    {{/if}}

    {{#if config.buysFromPlayers}}
      {{#if customer}}
        <h2><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "kaiserkram.trader.sheet.sellTo"}}</h2>
        <p class="hint">{{localize "kaiserkram.trader.sheet.dropHint"}}</p>
        {{#if sellable.length}}
          <table class="trader-table trader-sell">
            <thead>
              <tr>
                <th class="col-name">{{localize "kaiserkram.trader.sheet.item"}}</th>
                <th class="col-qty">{{localize "kaiserkram.trader.sheet.qty"}}</th>
                <th class="col-price">{{localize "kaiserkram.trader.sheet.offer"}}</th>
                <th class="col-actions"></th>
              </tr>
            </thead>
            <tbody>
              {{#each sellable}}
                <tr data-item-id="{{id}}">
                  <td class="col-name"><img src="{{img}}" alt="" /> {{name}}</td>
                  <td class="col-qty">{{qty}}</td>
                  <td class="col-price">{{offer}}</td>
                  <td class="col-actions">
                    <button type="button" data-action="sell" data-tooltip="{{localize "kaiserkram.trader.sheet.sell"}}">
                      <i class="fa-solid fa-hand-holding-dollar"></i>
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{/if}}
      {{/if}}
    {{/if}}

    {{#if isGM}}
      <h2><i class="fa-solid fa-user-gear"></i> {{localize "kaiserkram.trader.gm.title"}}</h2>
      <div class="trader-gm">
        <div class="gm-row">
          <label>{{localize "kaiserkram.trader.gm.markup"}}
            <input type="number" min="0" step="5" value="{{config.markup}}" data-config="markup" /> %
          </label>
          <label>{{localize "kaiserkram.trader.gm.sellRate"}}
            <input type="number" min="0" step="5" value="{{config.sellRate}}" data-config="sellRate" /> %
          </label>
          <label>{{localize "kaiserkram.trader.settlement.label"}}
            <select data-config="settlement">
              {{#each settlements}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="inline">
            <input type="checkbox" data-config="buysFromPlayers" {{#if config.buysFromPlayers}}checked{{/if}} />
            {{localize "kaiserkram.trader.gm.buysFromPlayers"}}
          </label>
        </div>
        <div class="gm-row">
          <span><i class="fa-solid fa-sack-dollar"></i> {{localize "kaiserkram.trader.gm.purse"}}: <b>{{purse}}</b></span>
          {{#unless enforcePurse}}<span class="hint">{{localize "kaiserkram.trader.gm.purseUnlimited"}}</span>{{/unless}}
        </div>
        {{#if haggleOn}}
          <h3>{{localize "kaiserkram.trader.gm.standings"}}</h3>
          {{#if standings.length}}
            <table class="trader-table trader-standings">
              <tbody>
                {{#each standings}}
                  <tr data-actor-id="{{actorId}}">
                    <td>{{name}}</td>
                    <td>{{#if penalty}}<span class="tag grudge">+{{penalty}}%</span>{{/if}}</td>
                    <td>{{deals}}</td>
                    <td class="col-actions">
                      <button type="button" data-action="forgiveCustomer" data-tooltip="{{localize "kaiserkram.trader.gm.forgive"}}">
                        <i class="fa-solid fa-handshake"></i>
                      </button>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
            <button type="button" data-action="resetHaggle"><i class="fa-solid fa-rotate-left"></i> {{localize "kaiserkram.trader.gm.resetHaggle"}}</button>
          {{else}}
            <p class="hint">{{localize "kaiserkram.trader.gm.noStandings"}}</p>
          {{/if}}
        {{/if}}
      </div>
    {{/if}}
  </div>
</section>

<div class="kaiserkram trader-dialog">
  <label>
    {{localize "kaiserkram.trader.restock.table"}}
    <select name="table">
      {{#each tables}}
        <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </label>
  <label>
    {{localize "kaiserkram.trader.restock.uuid"}}
    <input type="text" name="customUuid" value="{{customUuid}}" placeholder="Compendium.…RollTable.…" />
  </label>
  <label>
    {{localize "kaiserkram.trader.restock.rolls"}}
    <input type="number" name="rolls" min="1" step="1" value="5" />
  </label>
  <label>
    {{localize "kaiserkram.trader.settlement.label"}}
    <select name="settlement">
      {{#each settlements}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </label>
  <label class="inline">
    <input type="checkbox" name="clear" />
    {{localize "kaiserkram.trader.restock.clear"}}
  </label>
  <p class="hint">{{localize "kaiserkram.trader.restock.hint"}}</p>
</div>
